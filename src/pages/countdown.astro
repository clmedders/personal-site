---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
// import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
			<h1 class="text-center">May 4th is...</h1>
			<div class="px-4 mb-4">
				<div class="flex flex-col md:flex-row justify-center w-full">
					<div class="w-full md:w-1/4 p-4 text-center md:text-center">
						<p class="text-md font-bold">Days</p>
						<p id="days" class="text-3xl font-bold"></p>
					</div>
					<div class="w-full md:w-1/4 p-4 text-center md:text-center">
						<p class="text-lg font-bold">Hours</p>
						<p id="hours" class="text-3xl font-bold"></p>
				</div>
					<div class="w-full md:w-1/4 p-4 text-center md:text-center">
						<p class="text-lg font-bold">Minutes</p>
						<p id="mins" class="text-3xl font-bold"></p>
					</div>
					<div class="w-full md:w-1/4 p-4 text-center md:text-center">
						<p class="text-lg font-bold">Seconds</p>
						<p id="secs" class="text-3xl font-bold"></p>
					</div>
				</div>
			</div>
			<h2 class="text-center">Away!</h2>
		</main>
    <script src="../scripts/countdown.js"></script>
	</body>
</html>