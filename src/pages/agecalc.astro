---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header title={SITE_TITLE} />

    <!-- main {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background-color: hsl(0, 0%, 100%);
      border-radius: 10px 10px 90px 10px;
      font-family: 'Caveat', 'cursive';
      font-weight: bold;
      width: 400px;
      @media (max-width: 480px) {
        width: 300px; 
      }
    
    } -->
  <main class="margin: auto  bg-blue-950" >
		<h1 class=" text-center">Check Your Age</h1>
    <div>
      
    </div>
        <div class="inputs">
          <div class="inputText">
            <span>Month</span>
            <input type="text" maxlength="2" size="10" placeholder="MM" id="month">
          </div>
          <div class="inputText">
            <span>Day</span>
            <input type="text" maxlength="2" size="10" placeholder="DD" id="day">
          </div>
          <div class="inputText">
            <span>Year</span>
            <input type="text" maxlength="4" size="10" placeholder="YYYY" id="year">
          </div>
        </div>
        
        <div>
          <button class="btn">Age</button>
        </div>
        <p class="errorText"></p>
        <div class="answers">
          <p id="aYear">years</p>
          <p id="aMonth">months</p>
          <p id="aDay">days</p>
        </div>  
      </main>
    </body>
</html>

